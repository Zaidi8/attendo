rules_version = '2';

// Attendo — Sprint 0 baseline Firestore security rules.
//
// Data model (development-plan.md §6): every teacher-owned entity lives under
// users/{uid}. A signed-in user may read/write ONLY their own subtree; all
// other access is denied. Per-collection schema and field validation are
// finalized in Sprint 1 — this is the deny-by-default, owner-scoped baseline.
//
// Security is enforced here by authenticated UID, never by client-side
// filtering. Do not weaken these rules to simplify client work.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A user document and everything beneath it (classes, students,
    // attendance, …) is private to its owner.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny-by-default: any path not matched above is inaccessible.
  }
}
