# Attendo — example environment configuration.
#
# Copy to `.env` (gitignored) and adjust for your machine. Every variable is
# prefixed EXPO_PUBLIC_ so Expo inlines it into the client bundle at build time.
# These are NOT secrets: never place server-only credentials or privileged API
# keys here (they would ship inside the app binary).
#
# React Native Firebase reads native config from google-services.json /
# GoogleService-Info.plist — NOT from these variables. The values below control
# app-level behavior and optional local emulator wiring only.

# Target environment: "dev" | "production".
EXPO_PUBLIC_ENV=dev

# Route Firebase Auth/Firestore to local emulators (dev only): "true" | "false".
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

# Host the emulators listen on (used only when the flag above is "true").
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
