<?xml version="1.0" encoding="UTF-8"?>
<!--
  EXAMPLE ONLY — not the real config. Download the real GoogleService-Info.plist
  from the Firebase console (Project settings → your iOS app) and place it at the
  project root as GoogleService-Info.plist (gitignored). Do not edit by hand.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>API_KEY</key><string>REPLACE_WITH_IOS_API_KEY</string>
  <key>GCM_SENDER_ID</key><string>REPLACE_WITH_SENDER_ID</string>
  <key>BUNDLE_ID</key><string>com.attendo.app</string>
  <key>PROJECT_ID</key><string>attendo-dev</string>
  <key>STORAGE_BUCKET</key><string>attendo-dev.appspot.com</string>
  <key>GOOGLE_APP_ID</key><string>REPLACE_WITH_IOS_APP_ID</string>
  <key>IS_ADS_ENABLED</key><false/>
  <key>IS_ANALYTICS_ENABLED</key><false/>
  <key>IS_APPINVITE_ENABLED</key><true/>
  <key>IS_GCM_ENABLED</key><true/>
  <key>IS_SIGNIN_ENABLED</key><true/>
</dict>
</plist>
